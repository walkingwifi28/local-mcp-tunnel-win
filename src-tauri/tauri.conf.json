{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local MCP Tunnel",
  "version": "0.1.0",
  "identifier": "com.walkingwifi28.local-mcp-tunnel-win",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Local MCP Tunnel",
        "width": 1120,
        "height": 760,
        "minWidth": 800,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Windows controller for tunnel-client and local-mcp",
    "longDescription": "A Tauri desktop application that controls tunnel-client and local-mcp through WSL or native Windows executables.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
